          "html": "<!doctype html><html><head><meta charset=\"utf-8\"><style>*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;font-family:Segoe UI,sans-serif;background:transparent;color:white}.card{height:100%;padding:5%;border-radius:24px;background:#242335;display:flex;flex-direction:column;gap:16px}label,summary{font-size:clamp(16px,3vw,28px)}input[type=text],textarea{display:block;width:100%;background:#ffffff10;color:inherit;border:1px solid #ffffff40;border-radius:8px;padding:12px;font:inherit}input[type=text]{font-size:clamp(22px,4vw,38px)}textarea{font-size:clamp(16px,3vw,26px);height:160px;resize:none}input[type=checkbox]{width:24px;height:24px;accent-color:#a39bfa}details{padding:12px;border:1px solid #ffffff30;border-radius:8px}summary{cursor:pointer}p{font-size:clamp(14px,2.5vw,22px);line-height:1.4}small{opacity:.7;margin-top:auto}</style></head><body><section class=\"card\"><label>Topic<input type=\"text\" data-state-key=\"heading\" aria-label=\"Topic\"></label><label>Notes<textarea data-state-key=\"notes\" aria-label=\"Notes\"></textarea></label><label><input type=\"checkbox\" data-state-key=\"done\"> Discussed</label><details data-state-key=\"details\"><summary>Discussion prompts</summary><p>What changed this week? What needs a decision?</p></details><small>Click fields to edit. Use the outer handles to move or resize.</small></section></body></html>"
