{"format":"callayers","version":6,"title":"Untitled","scenes":[{"elements":[{"type":"card","id":"{CA243F27-9841-43C3-B8B8-992D1CD5BE2C}","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent;font-family:\"Segoe UI\",system-ui,sans-serif;color:#fff}body{text-shadow:0 2px 8px rgba(0,0,0,.7)}\n.wrap{width:100%;height:100%;padding:12px 18px;display:flex;align-items:flex-start;justify-content:flex-start}.card{width:min(100%,720px);display:flex;flex-direction:column;gap:7px}\n.top{display:flex;align-items:center;justify-content:space-between;gap:12px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.16em;color:#BAF2CD}.title{font-size:clamp(25px,4vw,35px);font-weight:750;line-height:1.05;letter-spacing:-.03em}\n.timer{display:flex;align-items:center;gap:9px;padding:5px 8px;border:1px solid rgba(255,255,255,.2);border-radius:11px;background:rgba(12,15,27,.14);white-space:nowrap}.timebox{display:flex;flex-direction:column;align-items:flex-start}.clock{font-variant-numeric:tabular-nums;font-size:clamp(20px,3vw,27px);line-height:1;font-weight:750;letter-spacing:.04em;color:#BAF2CD}.meeting-clock{font-size:clamp(18px,2.7vw,23px);color:#A39BFA}.clock-label{font-size:8px;letter-spacing:.1em;font-weight:800;color:rgba(255,255,255,.8);margin-top:3px}.divider{height:28px;width:1px;background:rgba(255,255,255,.2)}.actions{display:flex;gap:4px}.timer button{font:600 11px \"Segoe UI\",system-ui,sans-serif;color:#fff;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:7px;padding:5px 7px;cursor:pointer}.timer button:hover,.timer button:focus-visible{background:rgba(163,155,250,.35);outline:2px solid #A39BFA;outline-offset:1px}\n.agenda{display:grid;gap:4px}.item{border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(12,15,27,.12);overflow:hidden}.item[data-active=\"true\"]{border-color:rgba(163,155,250,.85);background:rgba(163,155,250,.12)}.choose{width:100%;min-height:34px;display:flex;align-items:center;gap:9px;padding:5px 10px;border:0;background:transparent;color:#fff;text-align:left;font:700 clamp(16px,2.3vw,20px)/1.15 \"Segoe UI\",system-ui,sans-serif;text-shadow:inherit;cursor:pointer}.choose:hover{background:rgba(163,155,250,.13)}.choose:focus-visible{outline:2px solid #A39BFA;outline-offset:-3px}.num{width:23px;height:23px;flex:0 0 23px;display:grid;place-items:center;border-radius:50%;background:rgba(255,255,255,.13);color:#BAF2CD;font-size:13px;font-weight:800}.item[data-active=\"true\"] .num{background:#A39BFA;color:#141329}.chevron{margin-left:auto;color:#BAF2CD;font-size:17px;transition:transform .18s}.choose[aria-expanded=\"true\"] .chevron{transform:rotate(180deg)}\n.detail{display:none;padding:1px 12px 8px 43px}.detail.open{display:grid;gap:5px}.point{display:flex;align-items:flex-start;gap:8px;font-size:clamp(14px,1.8vw,16px);line-height:1.3;font-weight:500}.bullet{color:#BAF2CD;font-weight:900}.notes{display:block;width:100%;min-height:36px;max-height:105px;resize:none;overflow-y:auto;padding:7px 9px;border:1px solid rgba(255,255,255,.25);border-radius:8px;background:rgba(12,15,27,.25);color:#fff;font:500 14px/1.35 \"Segoe UI\",system-ui,sans-serif;text-shadow:inherit}.notes::placeholder{color:rgba(255,255,255,.72)}.notes:focus{outline:2px solid #A39BFA;outline-offset:1px}.progress{height:3px;background:rgba(255,255,255,.17);border-radius:4px;overflow:hidden}.fill{height:100%;width:100%;background:linear-gradient(90deg,#A39BFA,#BAF2CD);transform-origin:left center}\n@media(max-width:520px){.wrap{padding:9px 10px}.card{gap:5px}.top{gap:6px}.timer{gap:5px;padding:4px 5px}.timer button{padding:4px 5px;font-size:9px}.clock-label{font-size:7px}.divider{height:24px}.choose{min-height:32px;padding:4px 7px;gap:7px}.num{width:21px;height:21px;flex-basis:21px;font-size:12px}.detail{padding:1px 8px 7px 35px}}\n@media(max-width:370px){.meeting-clock{font-size:16px}.clock{font-size:18px}.timer{gap:4px}.actions{gap:3px}.timer button{font-size:8px;padding:4px}}\n</style>\n</head>\n<body>\n<main class=\"wrap\" aria-label=\"Agenda and timers\"><div class=\"card\">\n<header class=\"top\"><div><div class=\"eyebrow\">RUN OF SHOW</div><div class=\"title\">Agenda</div></div><div class=\"timer\" aria-label=\"Section countdown and total meeting time; pause and reset control both timers\"><div class=\"timebox\"><div class=\"clock\" id=\"clock\" role=\"timer\" aria-live=\"off\">05:00</div><div class=\"clock-label\">SECTION · MIN:SEC</div></div><div class=\"divider\" aria-hidden=\"true\"></div><div class=\"timebox\"><div class=\"clock meeting-clock\" id=\"meetingClock\" role=\"timer\" aria-live=\"off\">00:00</div><div class=\"clock-label\">TOTAL MEETING</div></div><div class=\"actions\"><button id=\"pause\" type=\"button\" aria-label=\"Pause both timers\">Pause</button><button id=\"reset\" type=\"button\" aria-label=\"Reset both timers\">Reset</button></div></div></header>\n<nav class=\"agenda\" aria-label=\"Choose an agenda section\">\n<div class=\"item\" data-active=\"true\"><button class=\"choose\" type=\"button\" aria-expanded=\"false\" aria-controls=\"detail-0\"><span class=\"num\">0</span><span>James updates</span><span class=\"chevron\" aria-hidden=\"true\">⌄</span></button><div class=\"detail\" id=\"detail-0\"><textarea class=\"notes\" data-state-key=\"james-updates-notes\" aria-label=\"James updates notes\" placeholder=\"Write notes…\" rows=\"1\"></textarea></div></div>\n<div class=\"item\" data-active=\"false\"><button class=\"choose\" type=\"button\" aria-expanded=\"false\" aria-controls=\"detail-1\"><span class=\"num\">1</span><span>Callayers UX</span><span class=\"chevron\" aria-hidden=\"true\">⌄</span></button><div class=\"detail\" id=\"detail-1\"></div></div>\n<div class=\"item\" data-active=\"false\"><button class=\"choose\" type=\"button\" aria-expanded=\"false\" aria-controls=\"detail-2\"><span class=\"num\">2</span><span>Other apps</span><span class=\"chevron\" aria-hidden=\"true\">⌄</span></button><div class=\"detail\" id=\"detail-2\"></div></div>\n<div class=\"item\" data-active=\"false\"><button class=\"choose\" type=\"button\" aria-expanded=\"false\" aria-controls=\"detail-3\"><span class=\"num\">3</span><span>Callayers Distribution</span><span class=\"chevron\" aria-hidden=\"true\">⌄</span></button><div class=\"detail\" id=\"detail-3\"></div></div>\n</nav><div class=\"progress\" aria-hidden=\"true\"><div class=\"fill\" id=\"fill\"></div></div>\n</div></main>\n<script>\n(()=>{\n const agenda=[[],['WinUI3 / C++','App lends itself to overcomplication'],['ClickThat — haven’t done anything','Puppetbooth — blocked on Snap approval; looking into local lens renderer MVP'],['Malcolm going to 4 local meetups this week to shill the concept','Need hosting / deployment']];\n const buttons=[...document.querySelectorAll('.choose')],items=[...document.querySelectorAll('.item')],clock=document.getElementById('clock'),meetingClock=document.getElementById('meetingClock'),fill=document.getElementById('fill'),pauseBtn=document.getElementById('pause'),notes=document.querySelector('.notes');\n let active=0,remaining=300,running=true,last=Date.now(),meetingElapsed=0;\n agenda.forEach((points,i)=>{const box=document.getElementById('detail-'+i);points.forEach(text=>{const row=document.createElement('div');row.className='point';const bullet=document.createElement('span');bullet.className='bullet';bullet.textContent='•';const copy=document.createElement('span');copy.textContent=text;row.append(bullet,copy);box.appendChild(row)});});\n function growNotes(){notes.style.height='auto';notes.style.height=Math.min(notes.scrollHeight,105)+'px'}notes.addEventListener('input',growNotes);growNotes();\n function formatTime(totalSeconds){const s=Math.max(0,Math.floor(totalSeconds)),h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;return h>0?String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0'):String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0')}\n function advance(now){const delta=Math.max(0,(now-last)/1000);if(running){meetingElapsed+=delta;remaining=Math.max(0,remaining-delta)}last=now}\n function render(){clock.textContent=formatTime(remaining);meetingClock.textContent=formatTime(meetingElapsed);fill.style.transform='scaleX('+Math.max(0,remaining/300)+')';pauseBtn.textContent=running?'Pause':'Resume';pauseBtn.setAttribute('aria-label',running?'Pause both timers':'Resume both timers')}\n buttons.forEach((button,i)=>button.addEventListener('click',()=>{const now=Date.now();advance(now);const wasOpen=button.getAttribute('aria-expanded')==='true';if(i!==active){active=i;remaining=300}items.forEach((item,n)=>{item.dataset.active=String(n===i);const b=buttons[n],panel=document.getElementById('detail-'+n),open=n===i&&!wasOpen;b.setAttribute('aria-expanded',String(open));panel.classList.toggle('open',open)});render()}));\n pauseBtn.addEventListener('click',()=>{const now=Date.now();advance(now);running=!running;last=now;render()});document.getElementById('reset').addEventListener('click',()=>{last=Date.now();remaining=300;meetingElapsed=0;running=true;render()});setInterval(()=>{advance(Date.now());render()},100);render();\n})();\n</script>\n</body>\n</html>","name":"Agenda with James Updates","x":0.024136976373977589,"y":0.0693870323868392,"width":0.5046660885354961,"height":0.358879016161226,"state":{"james-updates-notes":"Puppetbooth\n- sdsfd\n-sdfsdf\nsdfsdf-\nsdfsdfs\nsdfadfdf\n"},"usage":{"model":"gpt-6-luna","input":3292,"output":3819,"cached":0,"cache_write":3289,"reasoning":1064,"estimated_usd":0.002320925}}]}]}