{"format":"callayers","version":5,"title":"Untitled","scenes":[{"elements":[{"type":"card","id":"{CA243F27-9841-43C3-B8B8-992D1CD5BE2C}","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent;font-family:\"Segoe UI\",system-ui,sans-serif;color:#fff}body{text-shadow:0 2px 8px rgba(0,0,0,.7)}\n.wrap{width:100%;height:100%;padding:18px 22px;display:flex;align-items:flex-start;justify-content:flex-start}.card{width:min(100%,720px);display:flex;flex-direction:column;gap:12px}\n.top{display:flex;align-items:center;justify-content:space-between;gap:16px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.18em;color:#BAF2CD}.title{font-size:clamp(34px,5vw,48px);font-weight:750;line-height:1.05;letter-spacing:-.03em}\n.timer{display:flex;align-items:center;gap:12px;padding:7px 10px;border:1px solid rgba(255,255,255,.2);border-radius:12px;background:rgba(12,15,27,.14);white-space:nowrap}.timebox{display:flex;flex-direction:column;align-items:flex-start}.clock{font-variant-numeric:tabular-nums;font-size:clamp(25px,3.5vw,34px);line-height:1;font-weight:750;letter-spacing:.04em;color:#BAF2CD}.meeting-clock{font-size:clamp(21px,3vw,29px);color:#A39BFA}.clock-label{font-size:10px;letter-spacing:.12em;font-weight:800;color:rgba(255,255,255,.76);margin-top:4px}.divider{height:36px;width:1px;background:rgba(255,255,255,.2)}.actions{display:flex;gap:5px}.timer button{font:600 12px \"Segoe UI\",system-ui,sans-serif;color:#fff;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:6px 8px;cursor:pointer}.timer button:hover,.timer button:focus-visible{background:rgba(163,155,250,.35);outline:2px solid #A39BFA;outline-offset:1px}\n.agenda{display:grid;gap:7px}.item{border:1px solid rgba(255,255,255,.2);border-radius:12px;background:rgba(12,15,27,.12);overflow:hidden}.item[data-active=\"true\"]{border-color:rgba(163,155,250,.85);background:rgba(163,155,250,.12)}.choose{width:100%;min-height:48px;display:flex;align-items:center;gap:12px;padding:8px 12px;border:0;background:transparent;color:#fff;text-align:left;font:700 clamp(18px,2.5vw,24px)/1.2 \"Segoe UI\",system-ui,sans-serif;text-shadow:inherit;cursor:pointer}.choose:hover{background:rgba(163,155,250,.13)}.choose:focus-visible{outline:2px solid #A39BFA;outline-offset:-3px}.num{width:29px;height:29px;flex:0 0 29px;display:grid;place-items:center;border-radius:50%;background:rgba(255,255,255,.13);color:#BAF2CD;font-size:15px;font-weight:800}.item[data-active=\"true\"] .num{background:#A39BFA;color:#141329}.chevron{margin-left:auto;color:#BAF2CD;font-size:19px;transition:transform .18s}.choose[aria-expanded=\"true\"] .chevron{transform:rotate(180deg)}\n.detail{display:none;padding:2px 16px 13px 53px}.detail.open{display:grid;gap:7px}.point{display:flex;align-items:flex-start;gap:9px;font-size:clamp(15px,2vw,18px);line-height:1.35;font-weight:500}.bullet{color:#BAF2CD;font-weight:900}.progress{height:3px;margin-top:1px;background:rgba(255,255,255,.17);border-radius:4px;overflow:hidden}.fill{height:100%;width:100%;background:linear-gradient(90deg,#A39BFA,#BAF2CD);transform-origin:left center}\n@media(max-width:650px){.wrap{padding:12px}.card{gap:9px}.top{gap:8px}.timer{gap:7px;padding:6px}.timer button{padding:5px 6px;font-size:10px}.clock-label{font-size:8px}.divider{height:30px}.actions{gap:4px}.choose{min-height:43px;padding:7px 9px;gap:9px}.num{width:25px;height:25px;flex-basis:25px;font-size:13px}.detail{padding:1px 10px 11px 43px}}\n@media(max-width:420px){.timer{gap:5px;padding:5px}.clock{font-size:22px}.meeting-clock{font-size:19px}.timer button{font-size:9px;padding:5px}.clock-label{letter-spacing:.08em}}\n</style>\n</head>\n<body>\n<main class=\"wrap\" aria-label=\"Agenda and timers\">\n  <div class=\"card\">\n    <header class=\"top\">\n      <div><div class=\"eyebrow\">RUN OF SHOW</div><div class=\"title\">Agenda</div></div>\n      <div class=\"timer\" aria-label=\"Section countdown and total meeting time; pause and reset control both timers\">\n        <div class=\"timebox\"><div class=\"clock\" id=\"clock\" role=\"timer\" aria-live=\"off\">05:00</div><div class=\"clock-label\">SECTION · MIN:SEC</div></div>\n        <div class=\"divider\" aria-hidden=\"true\"></div>\n        <div class=\"timebox\"><div class=\"clock meeting-clock\" id=\"meetingClock\" role=\"timer\" aria-live=\"off\">00:00</div><div class=\"clock-label\">TOTAL MEETING</div></div>\n        <div class=\"actions\"><button id=\"pause\" type=\"button\" aria-label=\"Pause both timers\">Pause</button><button id=\"reset\" type=\"button\" aria-label=\"Reset both timers\">Reset</button></div>\n      </div>\n    </header>\n    <nav class=\"agenda\" aria-label=\"Choose an agenda section\">\n      <div class=\"item\" data-active=\"true\"><button class=\"choose\" type=\"button\" aria-expanded=\"false\" aria-controls=\"detail-0\"><span class=\"num\">1</span><span>Callayers UX</span><span class=\"chevron\" aria-hidden=\"true\">⌄</span></button><div class=\"detail\" id=\"detail-0\"></div></div>\n      <div class=\"item\" data-active=\"false\"><button class=\"choose\" type=\"button\" aria-expanded=\"false\" aria-controls=\"detail-1\"><span class=\"num\">2</span><span>Other apps</span><span class=\"chevron\" aria-hidden=\"true\">⌄</span></button><div class=\"detail\" id=\"detail-1\"></div></div>\n      <div class=\"item\" data-active=\"false\"><button class=\"choose\" type=\"button\" aria-expanded=\"false\" aria-controls=\"detail-2\"><span class=\"num\">3</span><span>Callayers Distribution</span><span class=\"chevron\" aria-hidden=\"true\">⌄</span></button><div class=\"detail\" id=\"detail-2\"></div></div>\n    </nav>\n    <div class=\"progress\" aria-hidden=\"true\"><div class=\"fill\" id=\"fill\"></div></div>\n  </div>\n</main>\n<script>\n(()=>{\n const agenda=[\n  ['WinUI3 / C++','App lends itself to overcomplication'],\n  ['ClickThat — haven’t done anything','Puppetbooth — blocked on Snap approval; looking into local lens renderer MVP'],\n  ['Malcolm going to 4 local meetups this week to shill the concept','Need hosting / deployment']\n ];\n const buttons=[...document.querySelectorAll('.choose')],items=[...document.querySelectorAll('.item')];\n const clock=document.getElementById('clock'),meetingClock=document.getElementById('meetingClock'),fill=document.getElementById('fill'),pauseBtn=document.getElementById('pause');\n let active=0,remaining=300,running=true,last=Date.now(),meetingElapsed=0;\n agenda.forEach((points,i)=>{const box=document.getElementById('detail-'+i);points.forEach(text=>{const row=document.createElement('div');row.className='point';const bullet=document.createElement('span');bullet.className='bullet';bullet.textContent='•';const copy=document.createElement('span');copy.textContent=text;row.append(bullet,copy);box.appendChild(row)});});\n function formatTime(totalSeconds){const s=Math.max(0,Math.floor(totalSeconds));const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;return h>0?String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0'):String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0')}\n function advance(now){const delta=Math.max(0,(now-last)/1000);if(running){meetingElapsed+=delta;remaining=Math.max(0,remaining-delta)}last=now}\n function render(){clock.textContent=formatTime(remaining);meetingClock.textContent=formatTime(meetingElapsed);fill.style.transform='scaleX('+Math.max(0,remaining/300)+')';pauseBtn.textContent=running?'Pause':'Resume';pauseBtn.setAttribute('aria-label',running?'Pause both timers':'Resume both timers')}\n buttons.forEach((button,i)=>button.addEventListener('click',()=>{const now=Date.now();advance(now);const wasOpen=button.getAttribute('aria-expanded')==='true';if(i!==active){active=i;remaining=300}items.forEach((item,n)=>{item.dataset.active=String(n===i);const b=buttons[n],panel=document.getElementById('detail-'+n),open=n===i&&!wasOpen;b.setAttribute('aria-expanded',String(open));panel.classList.toggle('open',open)});render()}));\n pauseBtn.addEventListener('click',()=>{const now=Date.now();advance(now);running=!running;last=now;render()});\n document.getElementById('reset').addEventListener('click',()=>{last=Date.now();remaining=300;meetingElapsed=0;running=true;render()});\n setInterval(()=>{advance(Date.now());render()},100);\n render();\n})();\n</script>\n</body>\n</html>","name":"Agenda 10/12","x":0.024136976373977589,"y":0.0693870323868392,"width":0.37165520582691092,"height":0.25565320970961314,"state":{},"usage":{"model":"gpt-6-luna","input":3261,"output":3038,"cached":0,"cache_write":3258,"reasoning":499,"estimated_usd":0.00192655}}]}]}