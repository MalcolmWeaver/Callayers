// The two native products share source but use different renderer SDKs.
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 12.3
ONLY_ACTIVE_ARCH = YES
CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_CXX_LIBRARY = libc++
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_MODULES = YES
GCC_ENABLE_CPP_EXCEPTIONS = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
ENABLE_USER_SCRIPT_SANDBOXING = NO
ENABLE_HARDENED_RUNTIME = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ULTRALIGHT_ROOT[arch=x86_64] = $(SRCROOT)/../.deps/ultralight-macos-x64
ULTRALIGHT_ROOT[arch=arm64] = $(SRCROOT)/../.deps/ultralight-macos-arm64
CALLAYERS_ULTRALIGHT_MAJOR[arch=x86_64] = 1
CALLAYERS_ULTRALIGHT_MAJOR[arch=arm64] = 2
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) CALLAYERS_ULTRALIGHT_MAJOR=$(CALLAYERS_ULTRALIGHT_MAJOR)
HEADER_SEARCH_PATHS = $(inherited) "$(ULTRALIGHT_ROOT)/include" "$(SRCROOT)/Renderer"
LIBRARY_SEARCH_PATHS = $(inherited) "$(ULTRALIGHT_ROOT)/bin"
OTHER_LDFLAGS = $(inherited) -lAppCore -lUltralight -lUltralightCore -lWebCore -lc++
