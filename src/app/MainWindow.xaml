<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Callayers.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Callayers">
    <Grid Background="#121418">
        <SwapChainPanel x:Name="Stage" />
        <Image x:Name="Preview" Stretch="Uniform" />
        <Border
            Margin="16"
            Padding="12,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="#CC000000"
            CornerRadius="8"
            MaxWidth="640">
            <TextBlock
                x:Name="StatusText"
                Foreground="White"
                FontSize="14"
                TextWrapping="Wrap"
                Text="Starting" />
        </Border>
    </Grid>
</Window>
